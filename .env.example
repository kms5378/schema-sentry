SCHEMA_SENTRY_ENVIRONMENT=development
SCHEMA_SENTRY_METADATA_DATABASE_URL=postgresql+psycopg://schema_sentry:schema_sentry_dev@metadata-db:5432/schema_sentry
SCHEMA_SENTRY_SOURCE_DATABASE_URL=postgresql+psycopg://schema_sentry_reader:source_reader_dev@source-db:5432/game_source
SCHEMA_SENTRY_API_KEY=replace-with-openssl-rand-hex-32
SCHEMA_SENTRY_AUTH_DISABLED=true
SCHEMA_SENTRY_TRUST_PROXY_AUTH=false
SCHEMA_SENTRY_LOG_LEVEL=INFO
SCHEMA_SENTRY_SLACK_WEBHOOK_URL=
SCHEMA_SENTRY_SMTP_HOST=mailpit
SCHEMA_SENTRY_SMTP_PORT=1025
SCHEMA_SENTRY_EMAIL_FROM=schema-sentry@localhost
SCHEMA_SENTRY_EMAIL_TO=["owner@example.com"]
SCHEMA_SENTRY_DASHBOARD_BASE_URL=http://localhost:8000/
SOURCE_DB_ADMIN_PASSWORD=game_admin_dev
SOURCE_DB_READER_PASSWORD=source_reader_dev
SOURCE_DB_PIPELINE_PASSWORD=pipeline_writer_dev
METADATA_DB_PASSWORD=schema_sentry_dev
